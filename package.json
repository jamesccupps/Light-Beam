{
  "name": "beam",
  "version": "1.22.0",
  "private": true,
  "license": "MIT",
  "repository": "github:jamesccupps/Light-Beam",
  "description": "Self-hosted drop box for sending text, clipboard contents and files between your own devices.",
  "main": "server.js",
