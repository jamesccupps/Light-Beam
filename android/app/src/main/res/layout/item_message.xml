<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="3dp">

    <!-- Tap: open a file. Long-press on the text: select it in place. Long-press anywhere else: the item's menu. -->
    <app.beam.android.ui.BubbleLayout
        android:id="@+id/bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:longClickable="true"
        android:minWidth="72dp"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        tools:background="@drawable/bubble_theirs">

        <TextView
            android:id="@+id/sender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorPrimary"
            android:visibility="gone" />

        <!-- Selectable in place, like any text on Android; links (web, e-mail) stay tappable. Beam adds
             Forward / Delete / More… to the selection toolbar (MessageAdapter). -->
        <TextView
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:autoLink="web|email"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:linksClickable="true"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textIsSelectable="true"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/showAll"
            style="@style/Widget.Beam.BubbleButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-10dp"
            android:text="@string/show_all"
            android:visibility="gone" />

        <!-- Photos: just the picture, with the time on it. -->
        <FrameLayout
            android:id="@+id/imageBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/thumb"
                android:layout_width="@dimen/thumb_width"
                android:layout_height="180dp"
                android:background="@drawable/thumb_bg"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Beam.Photo" />

            <ImageView
                android:id="@+id/play"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_play_circle"
                android:visibility="gone"
                app:tint="#E6FFFFFF" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/imageProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                app:indicatorColor="#FFFFFFFF"
                app:trackColor="#40FFFFFF" />

            <TextView
                android:id="@+id/imageMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="6dp"
                android:background="@drawable/photo_meta_bg"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="#FFFFFFFF" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/fileCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/fileIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:importantForAccessibility="no"
                android:padding="9dp"
                android:src="@drawable/ic_file" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/fileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:maxLines="2"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <TextView
                    android:id="@+id/fileMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textAppearance="?attr/textAppearanceBodySmall" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:trackCornerRadius="2dp" />

        <!-- Only while something is being sent or received, or failed. -->
        <LinearLayout
            android:id="@+id/fileActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-10dp"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/actRetry"
                style="@style/Widget.Beam.BubbleButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/retry" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/actCancel"
                style="@style/Widget.Beam.BubbleButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/footer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:gravity="center_vertical"
            android:minHeight="24dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/pin"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="4dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_pin"
                android:visibility="gone" />

            <TextView
                android:id="@+id/meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textAppearance="?attr/textAppearanceLabelSmall" />

            <ImageView
                android:id="@+id/statusIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="4dp"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </LinearLayout>
    </app.beam.android.ui.BubbleLayout>
</FrameLayout>
