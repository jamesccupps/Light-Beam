<?xml version="1.0" encoding="utf-8"?>
<!-- A photo or video in the gallery (1.12): square, the picture cropped to fill it. Activated = picked. -->
<app.beam.android.ui.SquareFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    android:background="@color/surface2"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:longClickable="true">

    <ImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <!-- No preview (a video without one, a picture too big to fetch): its kind (the icon on top) and name. -->
    <TextView
        android:id="@+id/placeholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:drawablePadding="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="3"
        android:padding="8dp"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="@color/muted"
        android:visibility="gone"
        app:drawableTint="@color/muted" />

    <ImageView
        android:id="@+id/play"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="6dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_play_circle"
        android:visibility="gone" />

    <View
        android:id="@+id/pickedFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/pick_tile_bg"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/check"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:importantForAccessibility="no"
        android:src="@drawable/pick_check_photo"
        android:visibility="gone" />
</app.beam.android.ui.SquareFrameLayout>
