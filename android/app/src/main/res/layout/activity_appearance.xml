<?xml version="1.0" encoding="utf-8"?>
<!-- (1.14) Settings → Appearance: as the web's page (theme, accent colour, all devices or only this phone). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:colorBackground"
        app:liftOnScroll="true"
        app:liftOnScrollTargetViewId="@id/scroll">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:navigationContentDescription="@string/back"
            app:navigationIcon="@drawable/ic_back"
            app:title="@string/look_title" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/intro"
                style="@style/SettingsSummary"
                android:paddingStart="20dp"
                android:paddingTop="8dp"
                android:paddingEnd="20dp" />

            <TextView
                style="@style/SettingsHeader"
                android:text="@string/look_theme" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/themes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/themeAuto"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="2"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/look_theme_auto" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/themeLight"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="2"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/look_theme_light" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/themeDark"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="2"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/look_theme_dark" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                style="@style/SettingsHeader"
                android:text="@string/look_accent" />

            <!-- The colours (filled in by AppearanceActivity), five a row. -->
            <GridLayout
                android:id="@+id/swatches"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:columnCount="5" />

            <TextView
                android:id="@+id/customNote"
                style="@style/SettingsSummary"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:visibility="gone" />

            <TextView
                style="@style/SettingsHeader"
                android:text="@string/look_where" />

            <RadioGroup
                android:id="@+id/where"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingEnd="20dp">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/whereAll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/look_where_all" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/whereOwn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/look_where_own" />
            </RadioGroup>

            <TextView
                android:id="@+id/whereNote"
                style="@style/SettingsSummary"
                android:paddingStart="20dp"
                android:paddingEnd="20dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
