<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/rowMaster"
        style="@style/SettingsRow">

        <LinearLayout style="@style/SettingsTexts">

            <TextView
                style="@style/SettingsTitle"
                android:text="@string/pc_notifications_switch" />

            <TextView
                style="@style/SettingsSummary"
                android:text="@string/pc_notifications_switch_summary" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/master"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false" />
    </LinearLayout>

    <!-- Why it can't be switched on (an older server, not signed in). -->
    <TextView
        android:id="@+id/notice"
        style="@style/SettingsSummary"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:visibility="gone" />

    <!-- The one-time "notification access". -->
    <LinearLayout
        android:id="@+id/accessCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            style="@style/SettingsSummary"
            android:text="@string/pc_notifications_access" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/grant"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/pc_notifications_allow" />
    </LinearLayout>

    <!-- Replies from PCs reach the phone over its event stream. -->
    <LinearLayout
        android:id="@+id/stayCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            style="@style/SettingsSummary"
            android:text="@string/pc_notifications_stay" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/stayOn"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_stay_connected" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/addTile"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="@string/pc_notifications_add_tile"
        android:visibility="gone" />

    <TextView
        style="@style/SettingsHeader"
        android:text="@string/pc_notifications_show_on" />

    <LinearLayout
        android:id="@+id/showOn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        style="@style/SettingsHeader"
        android:text="@string/pc_notifications_apps" />

    <TextView
        style="@style/SettingsSummary"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="@string/pc_notifications_apps_summary" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/searchLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="4dp"
        android:hint="@string/pc_notifications_search"
        app:startIconDrawable="@drawable/ic_search">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/appsEmpty"
        style="@style/SettingsSummary"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:visibility="gone" />
</LinearLayout>
