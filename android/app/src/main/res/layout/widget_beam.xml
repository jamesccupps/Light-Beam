<?xml version="1.0" encoding="utf-8"?>
<!-- (1.12) The home-screen widget (ui/BeamWidget): the newest thing received on this phone, then quick sends. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/widgetLast"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_last_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="4dp"
        android:paddingEnd="6dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/widgetPreview"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/thumb_bg"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widgetFrom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widgetText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="3"
                android:textColor="@color/text"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widgetCopy"
            style="@style/WidgetButton"
            android:layout_marginEnd="6dp"
            android:drawableStart="@drawable/ic_widget_copy"
            android:text="@string/copy"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widgetSendClipboard"
            style="@style/WidgetButton"
            android:layout_marginEnd="6dp"
            android:drawableStart="@drawable/ic_widget_paste"
            android:text="@string/widget_send_clipboard" />

        <TextView
            android:id="@+id/widgetSendPhoto"
            style="@style/WidgetButton"
            android:drawableStart="@drawable/ic_widget_photo"
            android:text="@string/widget_send_photo" />
    </LinearLayout>
</LinearLayout>
